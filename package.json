{
  "name": "fluent-gallery",
  "private": true,
  "version": "1.0.11-slim",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "NODE_ENV=production vite build",
    "build:server": "node scripts/build-server.mjs",
    "preview": "vite preview",
    "start": "NODE_ENV=production node dist-server/index.js",
    "dev:full": "npm run dev",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "sharp": "^0.33.0",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@fingerprintjs/fingerprintjs": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/heic-decode": "^2.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.0",
    "ali-oss": "^6.20.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "esbuild": "^0.27.2",
    "exifr": "^7.1.3",
    "express": "^4.18.2",
    "heic-decode": "^2.1.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.562.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "tsx": "^4.7.0",
    "vite": "^6.2.0",
    "vitest": "^5.0.0"
  }
}
