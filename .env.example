# Runtime
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
GALLERY_DB_PATH=./data/gallery.db

# Frontend API
VITE_API_BASE_URL=http://localhost:3001/api

# Storage: local | oss
STORAGE_MODE=local
LOCAL_UPLOAD_DIR=./uploads
LOCAL_PUBLIC_URL=http://localhost:3001/uploads

# Object storage (required only when STORAGE_MODE=oss)
# Provider: aliyun | tencent
OSS_PROVIDER=aliyun
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your-bucket-name
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# Optional STS settings
# OSS_ROLE_ARN=acs:ram::1234567890123456:role/oss-role
# OSS_ROLE_SESSION_NAME=fluent-gallery-session
